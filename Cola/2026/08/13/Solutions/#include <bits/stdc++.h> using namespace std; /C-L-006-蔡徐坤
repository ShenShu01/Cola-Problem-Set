首先得先会迪杰斯特拉算法
#include <bits/stdc++.h>
using namespace std;
//#define int long long
int INF=1e9;
typedef struct{
    int t,v;
}p;
typedef struct{
    int s,k;
}q;
signed main(){
    int n,m,k;cin>>n>>m>>k;
    int s,t;cin>>s>>t;
    vector<vector<int> >mp(n,(vector<int>(k+1,INF)));//用于存储路线数值 mp[当前点][使用了k次免费次数]=最短数值 代表了起点到当前点使用k次免费次数的最短路径
    vector<vector<p> >a(n);//存储路线图
    for(int i=0;i<m;i++){
        int b,c,d;cin>>b>>c>>d;
        a[b].push_back({c,d});
        a[c].push_back({b,d});
    }
    mp[s][0]=0;
    queue<q>b;//创建队列，用于更新路径；
    b.push({s,0});//入队初始终点为0，不需要使用免费次数
    
    while(!b.empty()){
        q tt=b.front();b.pop();
        int ts=tt.s,cnt=tt.k;
        for(p i:a[ts]){
            if(mp[ts][cnt]+i.v<mp[i.t][cnt]){mp[i.t][cnt]=mp[ts][cnt]+i.v;b.push({i.t,cnt});}
            
            有免费次数：那么可以使用一次免费次数
            if(cnt<k){
                if(mp[ts][cnt]<mp[i.t][cnt+1]){mp[i.t][cnt+1]=mp[ts][cnt];b.push({i.t,cnt+1});}
            }
            
        }
    }
    int ans=INF;
    for(int i=0;i<=k;i++){
        //答案是到终点时使用i次免费次数的最小
        ans=min(ans,mp[t][i]);
    }
    cout<<ans;
}
